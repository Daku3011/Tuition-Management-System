# ==========================================
# Tuition Management System (TMS) Monorepo
# Environment Configuration Template
# ==========================================

# -----------------
# Backend (FastAPI)
# -----------------
APP_ENV=development
APP_NAME="Apex Tuition Management System"
API_V1_PREFIX=/api/v1
PORT=8001

# Database Configuration (PostgreSQL / Supabase connection pooling string)
# Example local postgres: postgresql+psycopg2://postgres:postgres@localhost:5432/tuition_db
# Example Supabase: postgresql+psycopg2://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./tuition_dev.db
TEST_DATABASE_URL=sqlite:///./tuition_test.db

# Authentication & Security
AUTH_SECRET_KEY=change-this-to-a-super-secure-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# Supabase Storage Integration (Private Object Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=tuition-documents

# Transactional Email Provider (SMTP or API)
EMAIL_PROVIDER_API_KEY=mock-email-key-for-dev
EMAIL_FROM=notifications@tuitionsystem.com
EMAIL_SMTP_HOST=smtp.mailtrap.io
EMAIL_SMTP_PORT=2525
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Payment Gateway (Razorpay/Stripe test credentials)
PAYMENT_PROVIDER_KEY_ID=rzp_test_sampleKey123
PAYMENT_PROVIDER_KEY_SECRET=rzp_secret_sampleSecretKey123
PAYMENT_WEBHOOK_SECRET=sample_webhook_secret_123

# Monitoring
SENTRY_DSN=

# -----------------
# Web (Next.js)
# -----------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------
# Mobile (Expo)
# -----------------
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8001/api/v1
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_SCHEME=tuitionapp
